{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "quienlohace-marketplace",
	"main": ".open-next/worker.js",
	"compatibility_date": "2025-08-01",
	// nodejs_compat es requerido por el adaptador de Next.js sobre Workers.
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// Un único binding por recurso: el código usa `env.DB` y `env.MEDIA`.
	// Sin `remote: true`, `wrangler dev` trabaja contra la D1 local; sólo los
	// comandos con `--remote` tocan la base de producción.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "quienlohace",
			"database_id": "be93c0ea-e93a-45a8-95cb-08ff9933ed28",
			"migrations_dir": "migrations"
		},
		{
			"binding": "ANALYTICS_DB",
			"database_name": "quienlohace-analytics",
			// Reemplazar por el ID que devuelve `wrangler d1 create quienlohace-analytics`
			// antes del primer deploy remoto. El UUID nulo permite trabajar con D1 local.
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "analytics-migrations"
		}
	],
	// Cloudflare Images: decodifica y recomprime dentro del worker (TR-042).
	// Es lo que permite verificar que un archivo es realmente una imagen y
	// guardar una versión regenerada en vez del original.
	//
	// Costo: las primeras 5.000 transformaciones únicas del mes son gratis, y
	// `info()` —la que hace la verificación— no cuenta. Como cada imagen se
	// transforma una sola vez al subirla y después se sirve desde R2, cada
	// foto gasta una transformación en toda su vida. Las imágenes se guardan
	// en R2 y no en Images, así que no corren los cargos de almacenamiento ni
	// de entrega.
	//
	// Si el binding no está habilitado en la cuenta, el flujo sigue andando
	// con las comprobaciones que no necesitan decodificar (firma binaria y
	// cabecera) y se guarda lo que llegó. Es una degradación conocida y
	// anotada en TR-042: ver `src/infrastructure/image-processing.ts`.
	"images": {
		"binding": "IMAGES"
	},
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "quienlohace-media"
		},
		{
			"binding": "ANALYTICS_RAW",
			"bucket_name": "quienlohace-analytics-raw"
		}
	],
	"vars": {
		"APP_URL": "https://quienlohace-marketplace.akiens-dev.workers.dev",
		"ANALYTICS_ENABLED": "false"
	}
}
